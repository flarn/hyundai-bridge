# Load into the process environment; the application does not parse .env files.
HYUNDAI_USERNAME=
HYUNDAI_PASSWORD=
HYUNDAI_REGION=EU
# Private directory, outside the checkout. Contains confidential session tokens.
HYUNDAI_SESSION_DIRECTORY=/absolute/path/to/private/hyundai-bridge
BRIDGE_ID=home
MQTT_HOST=mosquitto
MQTT_PORT=1883
MQTT_TLS=false
MQTT_USERNAME=
MQTT_PASSWORD=
# Variables ending in _FILE may supply credentials from mounted secret files
# instead of the matching environment variable (never configure both).

# Use a published image for remote deployment; see docs/nuc-deployment.md.
HYUNDAI_BRIDGE_IMAGE=hyundai-bridge:local
